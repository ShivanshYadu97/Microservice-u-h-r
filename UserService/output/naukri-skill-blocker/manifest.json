{
  "manifest_version": 3,
  "name": "Naukri Skill Blocker",
  "version": "1.0.0",
  "description": "Hide Naukri job cards containing blocked skills or keywords.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*",
        "https://naukri.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
